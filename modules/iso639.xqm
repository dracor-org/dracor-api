(: ISO 639-2/B codes that differ from the ISO 639-3 (= 639-2/T) code :)
declare variable $iso639:part2b := map {
  "alb": "sqi",
  "arm": "hye",
  "baq": "eus",
  "bur": "mya",
  "chi": "zho",
  "cze": "ces",
  "dut": "nld",
  "fre": "fra",
  "geo": "kat",
  "ger": "deu",
  "gre": "ell",
  "ice": "isl",
  "mac": "mkd",
  "mao": "mri",
  "may": "msa",
  "per": "fas",
  "rum": "ron",
  "slo": "slk",
  "tib": "bod",
  "wel": "cym"
};

(:~
 : Normalize a language code to ISO 639-3.
 :
 : The primary subtag of the code is mapped from ISO 639-1 or ISO 639-2/B to
 : ISO 639-3. Other three-letter codes are returned as they are, since ISO
 : 639-2/T codes of individual languages are also ISO 639-3 codes.
 :
 : @param $code Language code, e.g. `de`, `ger`, `deu` or `en-GB`
 : @return ISO 639-3 code, or empty sequence if the code is not recognized
 :)
declare function iso639:to-639-3($code as xs:string?) as xs:string? {
  let $primary := lower-case(tokenize(normalize-space($code), "[-_]")[1])
  return if (string-length($primary) eq 2) then
    $iso639:part1($primary)
  else if (map:contains($iso639:part2b, $primary)) then
    $iso639:part2b($primary)
  else if (matches($primary, "^[a-z]{3}$")) then
    $primary
  else (
  )
};
