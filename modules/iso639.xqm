  "ks": "kas",
  "ku": "kur",
  "kv": "kom",
  "kw": "cor",
  "ky": "kir",
  "la": "lat",
  "lb": "ltz",
  "lg": "lug",
  "li": "lim",
  "ln": "lin",
  "lo": "lao",
  "lt": "lit",
  "lu": "lub",
  "lv": "lav",
  "mg": "mlg",
  "mh": "mah",
  "mi": "mri",
  "mk": "mkd",
  "ml": "mal",
  "mn": "mon",
  "mr": "mar",
  "ms": "msa",
