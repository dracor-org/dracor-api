  "ht": "hat",
  "hu": "hun",
  "hy": "hye",
  "hz": "her",
  "ia": "ina",
  "id": "ind",
  "ie": "ile",
  "ig": "ibo",
  "ii": "iii",
  "ik": "ipk",
  "io": "ido",
  "is": "isl",
  "it": "ita",
  "iu": "iku",
  "ja": "jpn",
  "jv": "jav",
  "ka": "kat",
  "kg": "kon",
