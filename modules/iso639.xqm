xquery version "3.1";

(:~
 : Normalization of language codes to ISO 639-3
 :
 : The TEI files of the DraCor corpora use ISO 639-1 (`de`), ISO 639-2/B
 : (`ger`, `dut`) and ISO 639-3 (`deu`, `gsw`) codes in `@xml:lang`, sometimes
 : with region subtags (`en-GB`). CMDI and the CLARIN VLO expect ISO 639-3.
 :
 : The mappings are generated from the ISO 639-3 code table published by SIL
 : (https://iso639-3.sil.org/code_tables/download_tables, iso-639-3.tab).
 :)
module namespace iso639 = "http://dracor.org/ns/exist/v1/iso639";

(: ISO 639-1 code → ISO 639-3 code :)
declare variable $iso639:part1 := map {
  "aa": "aar",
  "ab": "abk",
  "ae": "ave",
  "af": "afr",
  "ak": "aka",
  "am": "amh",
  "an": "arg",
  "ar": "ara",
  "as": "asm",
  "av": "ava",
  "ay": "aym",
  "az": "aze",
  "ba": "bak",
  "be": "bel",
  "bg": "bul",
  "bi": "bis",
  "bm": "bam",
  "bn": "ben",
  "bo": "bod",
  "br": "bre",
  "bs": "bos",
  "ca": "cat",
  "ce": "che",
  "ch": "cha",
  "co": "cos",
  "cr": "cre",
  "cs": "ces",
  "cu": "chu",
  "cv": "chv",
  "cy": "cym",
  "da": "dan",
